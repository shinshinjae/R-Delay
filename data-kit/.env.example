# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요. (.env는 GitHub에 올리지 마세요)

# 공공데이터포털(data.go.kr) 마이페이지의 '일반 인증키(Decoding)'. Encoding 키를 넣어도 키트가 알아서 풉니다.
DATA_GO_KR_KEY=여기에_공공데이터포털_인증키

# (선택) 기상청 API허브 인증키. 승인에 시간이 걸리므로 비워 두고 기상자료개방포털 CSV를 써도 됩니다.
KMA_APIHUB_KEY=

# (선택) 자료를 다른 폴더에 두려면 주석을 풀고 경로를 적으세요
# RDELAY_DATA_DIR=D:/rdelay-data
